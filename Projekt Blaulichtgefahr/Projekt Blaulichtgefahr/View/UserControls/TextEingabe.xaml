<UserControl x:Class="Projekt_Blaulichtgefahr.View.UserControls.TextEingabe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Projekt_Blaulichtgefahr.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="200">
    <Grid Background="White">
        <TextBox x:Name="txtEingabe" VerticalAlignment="Center" FontSize="16" Background="Transparent" Margin="5" TextChanged="txtEingabe_TextChanged"/>
       
        <TextBlock x:Name="txtPlaceholder" Text="{Binding Placeholder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="10" FontWeight="Light" Foreground="DarkGray" Panel.ZIndex="-1"/>
    </Grid>
</UserControl>
