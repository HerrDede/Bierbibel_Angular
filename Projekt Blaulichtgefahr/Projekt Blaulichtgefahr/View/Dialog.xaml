<Window x:Class="Projekt_Blaulichtgefahr.View.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Blaulichtgefahr.View"
        mc:Ignorable="d"
        Title="Typischer Lichtstrom und größe der Leuchtfläche aus dem Datenblatt" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Name="lblQuestion" Grid.Column="1" Grid.Row="0">Typischer Lichtstrom (des interpolierten Spektrums) [lm]:</Label>
        <TextBox Name="txtAnswer" Grid.Column="1" Grid.Row="1" MinWidth="250"></TextBox>
        <Label Name="lblQuestion2" Grid.Column="1" Grid.Row="2">Kantenlänge/Radius der Leuchtfläche [mm]:</Label>
        <TextBox Name="txtAnswer2" Grid.Column="1" Grid.Row="3" MinWidth="250"></TextBox>
        <CheckBox Name ="lblCheck1" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" >Radius</CheckBox>
        <CheckBox Name ="lblCheck2" Grid.Column="1" Grid.Row="5" >Kantenlänge</CheckBox>
            
        

        <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button IsDefault="True" Name="btnDialogOk" Click="btnDialogOk_Click" MinWidth="60" Margin="0,0,10,0">_Ok</Button>
            <Button IsCancel="True" MinWidth="60">_Cancel</Button>
        </WrapPanel>
    </Grid>
</Window>
